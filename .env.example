# Copia questo file in ".env" e compila i valori reali. Non condividere mai il file ".env"!

# Chiave API Anthropic (Claude) - la trovi su https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Modello Claude da usare (haiku = più economico/veloce, sonnet = più capace)
CLAUDE_MODEL=claude-sonnet-5

# Password per accedere al pannello di controllo admin (SCEGLINE UNA FORTE)
ADMIN_PASSWORD=cambia-questa-password-ora

# Numero massimo di domande al mese per utente
MAX_QUESTIONS_PER_MONTH=50

# Porta su cui gira il server (Railway/Render la impostano automaticamente)
PORT=3000
